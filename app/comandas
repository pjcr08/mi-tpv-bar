'use client'

import { useState, useEffect } from 'react'
import { supabase } from '@/lib/supabase'

export default function ComandasBarra() {
  const [pedidos, setPedidos] = useState([])
  const [cargando, setCargando] = useState(true)

  useEffect(() => {
    cargarComandas()
    
    // Suscripción en tiempo real a Supabase
    const canal = supabase
      .channel('cambios-comandas')
      .on('postgres_changes', { event: '*', schema: 'public', table: 'pedidos' }, () => {
        cargarComandas()
      })
      .on('postgres_changes', { event: '*', schema: 'public', table: 'lineas_pedido' }, () => {
        cargarComandas()
      })
      .subscribe()

    return () => {
      supabase.removeChannel(canal)
    }
  }, [])

  const cargarComandas = async () => {
    setCargando(true)
    try {
      // Obtenemos los pedidos que NO están ni 'servido' ni 'cobrado' ni 'cancelado'
      const { data, error } = await supabase
        .from('pedidos')
        .select(`
          id,
          estado,
          created_at,
          mesas ( numero, zona ),
          lineas_pedido ( id, producto_nombre, cantidad, estado, destino )
        `)
        .neq('estado', 'servido')
        .neq('estado', 'cobrado')
        .neq('estado', 'cancelado')
        .order('created_at', { ascending: true })

      if (error) throw error
      setPedidos(data || [])
    } catch (err) {
      console.error('Error cargando comandas:', err)
    } finally {
      setCargando(false)
    }
  }

  // ACCIÓN 1: SERVIR COMANDA COMPLETA (Marca como servida y la quita)
  const servirComanda = async (pedidoId) => {
    try {
      // 1. Cambiar estado del pedido
      await supabase
        .from('pedidos')
        .update({ estado: 'servido' })
        .eq('id', pedidoId)

      // 2. Cambiar estado de sus líneas
      await supabase
        .from('lineas_pedido')
        .update({ estado: 'servido' })
        .eq('pedido_id', pedidoId)

      // Actualizar UI en local al instante
      setPedidos((prev) => prev.filter((p) => p.id !== pedidoId))
    } catch (err) {
      alert('Error al marcar como servida: ' + err.message)
    }
  }

  // ACCIÓN 2: BORRAR / CANCELAR COMANDA (La elimina de la vista y BD)
  const borrarComanda = async (pedidoId) => {
    if (!confirm('¿Seguro que quieres borrar/cancelar esta comanda?')) return

    try {
      // Opción A: Borrar líneas y pedido directamente
      await supabase.from('lineas_pedido').delete().eq('pedido_id', pedidoId)
      await supabase.from('pedidos').delete().eq('id', pedidoId)

      // Actualizar UI en local al instante
      setPedidos((prev) => prev.filter((p) => p.id !== pedidoId))
    } catch (err) {
      alert('Error al borrar comanda: ' + err.message)
    }
  }

  return (
    <div className="min-h-screen bg-slate-950 text-white p-4 font-sans select-none">
      {/* HEADER DE COMANDAS */}
      <header className="flex justify-between items-center mb-6 border-b border-slate-800 pb-3">
        <div className="flex items-center gap-3">
          <span className="text-3xl">🍹</span>
          <h1 className="text-2xl font-black text-cyan-400 tracking-wider">
            COMANDAS DE BARRA
          </h1>
          <span className="bg-slate-800 text-cyan-300 font-bold px-3 py-1 rounded-full text-xs">
            {pedidos.length} Pendientes
          </span>
        </div>

        <div className="flex gap-2">
          <button
            onClick={cargarComandas}
            className="bg-slate-800 hover:bg-slate-700 text-white font-bold px-4 py-2 rounded-lg text-sm transition border border-slate-700 flex items-center gap-2"
          >
            🔄 Recargar
          </button>
        </div>
      </header>

      {/* REJILLA DE COMANDAS */}
      {cargando && pedidos.length === 0 ? (
        <div className="text-center py-20 text-slate-500 font-bold">
          Cargando comandas...
        </div>
      ) : pedidos.length === 0 ? (
        <div className="text-center py-20 text-slate-600 font-bold text-xl">
          🎉 ¡Todo servido! No hay comandas pendientes.
        </div>
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 xl:grid-cols-5 gap-4">
          {pedidos.map((pedido) => {
            const hora = new Date(pedido.created_at).toLocaleTimeString([], {
              hour: '2-digit',
              minute: '2-digit',
            })
            const mesaNombre = pedido.mesas
              ? `${pedido.mesas.zona || ''} Mesa ${pedido.mesas.numero}`
              : `Mesa ${pedido.id}`

            return (
              <div
                key={pedido.id}
                className="bg-slate-900 border-2 border-cyan-800/60 rounded-xl p-3 flex flex-col justify-between shadow-xl hover:border-cyan-500 transition"
              >
                {/* Cabecera Tarjeta */}
                <div>
                  <div className="flex justify-between items-center border-b border-slate-800 pb-2 mb-3">
                    <span className="font-black text-cyan-400 text-lg">
                      {mesaNombre}
                    </span>
                    <span className="bg-slate-950 text-slate-400 text-xs font-bold px-2 py-0.5 rounded border border-slate-800">
                      🕒 {hora}
                    </span>
                  </div>

                  {/* Lista de Productos */}
                  <div className="space-y-2 mb-4">
                    {pedido.lineas_pedido?.map((linea) => (
                      <div
                        key={linea.id}
                        className="flex items-center justify-between text-sm bg-slate-950/60 p-2 rounded border border-slate-800/80"
                      >
                        <span className="font-bold text-slate-200">
                          <strong className="text-cyan-400 font-black mr-1.5">
                            {linea.cantidad}x
                          </strong>
                          {linea.producto_nombre}
                        </span>
                        <span className="text-emerald-400 text-xs">✔</span>
                      </div>
                    ))}
                  </div>
                </div>

                {/* BOTONES DE ACCIÓN (SERVIR / BORRAR) */}
                <div className="flex gap-1.5 pt-2 border-t border-slate-800">
                  <button
                    onClick={() => servirComanda(pedido.id)}
                    className="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white font-black text-xs py-2.5 px-2 rounded-lg transition uppercase flex items-center justify-center gap-1 shadow"
                  >
                    ✔ SERVIR
                  </button>

                  <button
                    onClick={() => borrarComanda(pedido.id)}
                    title="Borrar / Cancelar Comanda"
                    className="bg-rose-900 hover:bg-rose-700 text-rose-200 font-black text-xs px-3 rounded-lg transition border border-rose-700 flex items-center justify-center"
                  >
                    🗑️
                  </button>
                </div>
              </div>
            )
          })}
        </div>
      )}
    </div>
  )
}
